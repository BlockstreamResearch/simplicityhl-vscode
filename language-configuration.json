{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"" },
        { "open": "/*", "close": " */" }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "onEnterRules": [
      {
          "beforeText": "^\\s*\\/{3}.*$",
          "action": {
              "indent": "none",
              "appendText": "/// "
          }
      },
      {
          "beforeText": "^\\s*\\/\\*(\\*|!)(?!\\/)([^*]|\\*(?!\\/))*$",
          "afterText": "^\\s*\\*\\/$",
          "action": {
              "indent": "indentOutdent",
              "appendText": " * "
          }
      },
      {
          "beforeText": "^\\s*\\/\\*(\\*|!)(?!\\/)([^*]|\\*(?!\\/))*$",
          "action": {
              "indent": "none",
              "appendText": " * "
          }
      },
      {
          "beforeText": "^( {2})* \\*( ([^*]|\\*(?!\\/))*)?$",
          "action": {
              "indent": "none",
              "appendText": "* "
          }
      },
      {
          "beforeText": "^( {2})* \\*\\/\\s*$",
          "action": {
              "indent": "none",
              "removeText": 1
          }
      }
    ]
}
