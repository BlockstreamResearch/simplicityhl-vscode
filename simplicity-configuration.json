{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["comment"] },
    { "open": "{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["#{", "}"]
  ],
  "wordPattern": "2\\^[0-9]+|0b[01]+|0x[0-9a-fA-F]+|[0-9]+|(?!->)[a-zA-Z_.'-][0-9a-zA-Z_.'-]*"
}
